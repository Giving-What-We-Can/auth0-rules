# Copy to .env and set the target tenant and Management API credentials.
# See README for supported tenant hosts. Never commit .env.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Keep PostgreSQL SSL enabled when generating database scripts.
NODE_ENV=production

# Optional: assert the tenant namespace. Otherwise the manifest supplies it.
# Production: https://parfit.givingwhatwecan.org
# Dev: https://parfit.givingwhatwecan.org/ (preserve the trailing slash)
